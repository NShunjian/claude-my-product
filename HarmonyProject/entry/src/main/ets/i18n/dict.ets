/**
 * i18n 字典:对齐 uniapp i18n/dict.ts 1:1。
 * ponytail: 保持字面键名一致;三种语言 zh-CN / en / zh-TW;Arg 形参走 {name} 占位。
 */

export type Lang = 'zh-CN' | 'en' | 'zh-TW'

export class Dict {
  private store: Map<string, string>
  constructor(entries: Record<string, string>) {
    this.store = new Map<string, string>()
    const keys = Object.keys(entries)
    for (let i = 0; i < keys.length; i++) {
      const k = keys[i]
      this.store.set(k, entries[k])
    }
  }
  get(key: string): string | undefined { return this.store.get(key) }
}

