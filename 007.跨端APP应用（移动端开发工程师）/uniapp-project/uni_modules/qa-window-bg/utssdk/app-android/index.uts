 * 的状态栏色,且 Android WebView 一般不强制圆角 mask。这里留 no-op 占位即可。
 */
export function setWindowBackgroundColor(color: string): void {}

export function restoreWindowBackgroundColor(): void {}

export function captureWindowBackgroundColor(): void {}