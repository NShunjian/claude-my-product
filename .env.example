# QingZhang 环境变量模板 — 复制为 .env 后填真值
# cp .env.example .env && vim .env
#
# 两个 MySQL 库(物理隔离):
#   - qingzhang / java-qingzhang  业务库(users/books/records/categories 等)
#   - qingzhang_admin             后台管理库(admin_users/admin_roles/admin_audit_logs 等)
# 同实例不同 schema 即可,生产可换不同 host。
#
# 首次启动:AdminBootstrapService 用 ADMIN_BOOTSTRAP_* 自动建超管
# 后续启动:同名变量若已存在用户,跳过(幂等)

# —— 业务库 ——
DB_HOST=localhost
DB_PORT=3307
DB_NAME=java-qingzhang
DB_USER=root
DB_PASSWORD=java123

# —— 管理后台库(默认与业务库同实例,不同 schema)——
ADMIN_DB_HOST=localhost
ADMIN_DB_PORT=3307
ADMIN_DB_NAME=qingzhang_admin
ADMIN_DB_USER=root
ADMIN_DB_PASSWORD=java123

# —— 首次启动超管引导 ——
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-strong-password

# —— JWT 密钥(必须 ≥ 32 字节,与前端共享)——
JWT_SECRET=please-change-me-to-shared-secret-with-node-must-be-at-least-32-bytes

# —— 全局 LAN IP ——
# 换 WiFi 时直接改下方这一行。**不要**写 ${VAR:-default} — Vite 的 loadEnv /
# VSCode 的 envFile 都是 dotenv 风格解析器,不做 shell 展开,会把字面字符串塞进 LAN_IP。
# 默认值用 localhost — 桌面 dev 直接能跑(浏览器 → localhost:4001 → 后端 OK);
# 手机扫码访问需要把这里换成你本机实际 IP,然后 ./start-backend 重启 + Vite 重启。
#
# 影响范围:
#   • 后端 CorsConfig 允许的 http://${LAN_IP}:5173/5174/5180/5181
#   • .vscode/launch.json Flutter Web Phone LAN 的 --web-hostname
#   • Vite(uniapp/003/006)通过 loadEnv 读取,构造 VITE_API_BASE=http://${LAN_IP}:4001
# 手机扫码 / 局域网访问 dev 都依赖此值。Flutter web 用 window.location.hostname 自动跟随,无须再设。
LAN_IP=localhost