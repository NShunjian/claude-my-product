#!/usr/bin/env bash
# 一键启停 — admin 后台前端 (http://localhost:5174)
#
# 用法:
#   ./start-admin [start|stop|status]

set -u
# 解析软链(支持从 /usr/local/bin 软链调用)
SCRIPT_REAL="$(readlink -f "$0" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_REAL")" && pwd)"
source "$SCRIPT_DIR/lib-qz.sh"

case "${1:-start}" in
  stop)   qz_stop_admin_frontend ;;
  status) echo "── 状态 ──"; qz_status ;;
  start|"")
    qz_start_admin_frontend
    echo
    echo "── 入口 ──"
    echo "  管理后台  http://localhost:$ADMIN_FRONTEND_PORT"
    echo "  日志      $ADMIN_FRONTEND_LOG"
    echo "  停服      ./start-admin stop" ;;
  *) echo "用法: $0 {start|stop|status}"; exit 1 ;;
esac