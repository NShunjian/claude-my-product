{
  "name": "frontend-react-java",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run 'src/**/*.{test,spec}.{ts,tsx}'",
    "test:integration": "vitest run 'tests/integration/**'",
    "test:contract": "vitest run 'tests/contract/**'",
    "test:e2e": "playwright test --config=tests/playwright.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:report": "npm run test:coverage && npm run test:report:copy",
    "test:report:copy": "node tests/scripts/copy-report.mjs 003-frontend-react-java"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}