class DictMap {
  private store: Map<Lang, Dict>
  constructor(entries: Record<Lang, Dict>) {
    this.store = new Map<Lang, Dict>()
    const codes: Lang[] = ['zh-CN', 'en', 'zh-TW']
    for (let i = 0; i < codes.length; i++) {
      const c = codes[i]
      this.store.set(c, entries[c])
    }
  }
  get(lang: Lang): Dict | undefined { return this.store.get(lang) }
}
const dicts: DictMap = new DictMap({ 'zh-CN': zhCN, 'en': en, 'zh-TW': zhTW })

export class I18nArgs {
  private store: Map<string, string | number>
  constructor(name: string, value: string | number) {
    this.store = new Map<string, string | number>()
    this.store.set(name, value)
  }
  get(k: string): string | number | undefined { return this.store.get(k) }
}

export function t(lang: Lang, key: string, args?: I18nArgs): string {
  const d: Dict | undefined = dicts.get(lang)
  const fallback: Dict | undefined = dicts.get('zh-CN')
  const s: string = d?.get(key) ?? fallback?.get(key) ?? key
  if (!args) return s
  return s.replace(/\{(\w+)\}/g, (_match: string, k: string): string => {
    const v: string | number | undefined = args.get(k)
    return v !== undefined ? String(v) : `{${k}}`
  })
}
