{
  "name": "qingzhang-app",
  "version": "0.1.0",
  "main": "main.js",
  "description": "轻账 — 个人 / 共享 / 生意 记账 uni-app",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run 'tests/unit/**'",
    "test:stores": "vitest run 'tests/stores/**'",
    "test:e2e": "playwright test --config=tests/playwright.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:report": "npm run test:coverage && npm run test:report:copy",
    "test:report:copy": "node tests/scripts/copy-report.mjs 007-uniapp-project"
  },
  "dependencies": {
    "pinia": "2.1.7",
    "uview-plus": "^3.3.62",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.0",
    "vconsole": "^3.15.1",
    "vitest": "^2.1.8"
  }
}